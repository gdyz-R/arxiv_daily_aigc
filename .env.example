# Copy this file to .env for local runs. The real .env is ignored by Git.
# GitHub Actions maps Repository Secrets and Variables to these names.
COARSE_LLM_API_KEY=
COARSE_LLM_BASE_URL=
COARSE_LLM_MODEL=
COARSE_LLM_TOKEN_FIELD=max_tokens
COARSE_LLM_REASONING_FORMAT=none
COARSE_LLM_REASONING_EFFORT=

EDITORIAL_LLM_API_KEY=
EDITORIAL_LLM_BASE_URL=
EDITORIAL_LLM_MODEL=
EDITORIAL_LLM_TOKEN_FIELD=max_tokens
EDITORIAL_LLM_REASONING_FORMAT=none
EDITORIAL_LLM_REASONING_EFFORT=

SEMANTIC_SCHOLAR_API_KEY=
# Optional memory loop. Use a secret/unlisted Gist containing concept_ledger.json.
# This release stores readable JSON; a secret Gist is not end-to-end encryption.
GIST_ID=
GIST_TOKEN=
# Optional, non-secret contact email used for the OpenAlex polite pool.
OPENALEX_MAILTO=